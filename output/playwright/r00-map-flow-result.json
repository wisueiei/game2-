  "transcripts": [
    {
      "branch": "do_not_help",
      "text": "ยินดีต้องรับคุณแฟนอิอิ"
    },
    {
      "branch": "do_not_help",
      "text": ". . ."
    },
    {
      "branch": "do_not_help",
      "text": "เข้ามาถึงที่นี่แล้วหรอเนี่ยไวจัง"
    },
    {
      "branch": "do_not_help",
      "text": "ง้าาา เจ้าหนูสุขสันวันครบรอบ"
    },
    {
      "branch": "do_not_help",
      "text": "1ปี3เดือนนะครับ"
    },
    {
      "branch": "do_not_help",
      "text": "เราอยู่ด้วยกันมาได้อีกเดือนแย้วนะเนี่ยย"
    },
    {
      "branch": "do_not_help",
      "text": "เธอรู้สึกคุ้นๆกับฉากนี้มั้ยนะ"
    },
    {
      "branch": "do_not_help",
      "text": "ทำไมเค้ารู้สึกเหมือน. . ."
    },
    {
      "branch": "do_not_help",
      "text": "เราเคยผ่านมันมารอบนึงแล้วเยยหละ. . ."
    },
    {
      "branch": "do_not_help",
      "text": "เค้าว่าเรา. .อาจจะโดนเข้ามาแทรกแทรงกับ อึกก!!"
    },
    {
      "branch": "do_not_help",
      "text": "✋︎⧫︎ ♓︎⬧︎ ⬧︎□︎ ♎︎♋︎❒︎🙵 ♒︎♏︎❒︎♏︎📬︎"
    },
    {
      "branch": "do_not_help",
      "text": "👎︎♋︎❒︎🙵♏︎❒︎ ⬧︎⧫︎♓︎●︎●︎📬︎"
    },
    {
      "branch": "do_not_help",
      "text": "✌︎■︎♎︎ ♎︎♋︎❒︎🙵♏︎❒︎ ⍓︎♏︎⧫︎📬︎"
    },
    {
      "branch": "do_not_help",
      "text": "☟︎□︎⬥︎ ♓︎■︎⧫︎♏︎❒︎♏︎⬧︎⧫︎♓︎■︎♑︎📬︎"
    },
    {
      "branch": "do_not_help",
      "text": "✌︎❒︎♏︎ ⍓︎□︎◆︎ ♋︎ ♒︎◆︎❍︎♋︎■︎ ⬥︎♒︎□︎ ♐︎♏︎●︎●︎ ♎︎□︎⬥︎■︎ ♒︎♏︎❒︎♏︎✍︎"
    },
    {
      "branch": "do_not_help",
      "text": "✡︎□︎◆︎ ♒︎♋︎❖︎♏︎ ♓︎⧫︎◻︎⧫︎♒︎♏︎ ⧫︎♒︎♓︎■︎♑︎ ⧫︎♒︎♋︎⧫︎ ⬥︎♓︎●︎●︎"
    },
    {
      "branch": "do_not_help",
      "text": "♏︎■︎♋︎♌︎●︎♏︎ ❍︎⍓︎ ❒︎♏︎⧫︎◆︎❒︎■︎📬︎ ✋︎■︎⧫︎♏︎❒︎♏︎⬧︎⧫︎♓︎■︎♑︎📪︎ ❖︎♏︎❒︎⍓︎ ♓︎■︎⧫︎♏︎❒︎♏︎⬧︎⧫︎♓︎■︎♑︎📬︎"
    },
    {
      "branch": "do_not_help",
      "text": "อื่มม . . ."
    },
    {
      "branch": "do_not_help",
      "text": "อาจจะไม่ได้มีอะไรมากแต่ว่า"
    },
    {
      "branch": "do_not_help",
      "text": "เดี๋ยวมารอดูนะครับ คิคิ"
    },
    {
      "branch": "do_not_help",
      "text": "หื้ออ บีบี๋เธอมาที่นี่แล้วหรอ. . ."
    },
    {
      "branch": "do_not_help",
      "text": "ตะไมมาช้าจางง"
    },
    {
      "branch": "do_not_help",
      "text": "เธอเจ็บขามั้ยตกมาซะสูงเลย"
    },
    {
      "branch": "do_not_help",
      "text": "เดี๋ยวเราจะเดินไปที่ของเค้ากัน. . . ที่เดิม"
    },
    {
      "branch": "do_not_help",
      "text": "ที่เราค่อยอยู่"
    },
    {
      "branch": "do_not_help",
      "text": "555555"
    },
    {
      "branch": "do_not_help",
      "text": "เธออาจจะนึกภาพมันไม่ออกหรอก ผ่านมานานมากแล้ว"
    },
    {
      "branch": "do_not_help",
      "text": "อื่มม. . . ."
    },
    {
      "branch": "do_not_help",
      "text": "นานแล้วแหละ"
    },
    {
      "branch": "do_not_help",
      "text": "แต่เธอเจ็บขามั้ยนะเค้าถามแล้วก็ลืมเลย"
    },
    {
      "branch": "do_not_help",
      "text": "โอเค งั้นเธอค่อยๆเดินมานะ"
    },
    {
      "branch": "do_not_help",
      "text": "เอ้า เค้าจะบอกวิธีเดินให้นะ"
    },
    {
      "branch": "do_not_help",
      "text": "w  คือเดินหน้า"
    },
    {
      "branch": "do_not_help",
      "text": "a  คือไปทางซ้าย"
    },
    {
      "branch": "do_not_help",
      "text": "s  คือถอยหลัง"
    },
    {
      "branch": "do_not_help",
      "text": "d  คือไปทางขวา"
    },
    {
      "branch": "do_not_help",
      "text": "ค่อยๆเดินมานะ อย่ารีบ. . . เค้ารอเธออยู่"
    },
    {
      "branch": "do_not_help",
      "text": "เธอมองเห็นทางมั้ย"
    },
    {
      "branch": "do_not_help",
      "text": "เหมือนตรงนั้นมีอะไรซักอย่างทำให้เค้าเข้าไปไม่ได้เลย"
    },
    {
      "branch": "do_not_help",
      "text": "เธอเอ่อ. . ."
    },
    {
      "branch": "do_not_help",
      "text": "เค้าจะลองใช้พลังสร้างอะไรซักอย่างดู"
    },
    {
      "branch": "do_not_help",
      "text": "ให้เธอลองเดินไปรอบๆ"
    },
    {
      "branch": "do_not_help",
      "text": "เธอจะเห็นขวดแก้วนึงที่มีไฟวิญญาณสีฟ้าม่วงลอยอยู่"
    },
    {
      "branch": "do_not_help",
      "text": "เก็บมันขึ้นมาเลย แล้วแสงมันจะสว่างพอที่จะนำทางเธอได้อยู่นิดหน่อย"
